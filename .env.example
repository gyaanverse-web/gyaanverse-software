# ═══════════════════════════════════════════════════════════════════════════════
# GYAANVERSE BACKEND — ENVIRONMENT VARIABLES
#
# Copy to `.env` and fill in. Every variable is explained below.
# Full reference, including the frontend / ops panel / AI engine:
#   docs/ENVIRONMENT.md
#
# HOW TO READ THIS FILE
#   [REQUIRED]      the API refuses to start without it, in every environment
#   [PROD ONLY]     required in production; may be left empty in dev
#   [OPTIONAL]      has a working default — the default is shown
#   [DEV ONLY]      only does anything when NODE_ENV is not production
#
# The same file is used by the API (src/server.ts) and the worker
# (src/worker.ts). On Railway both services need the whole set, not half each.
# ═══════════════════════════════════════════════════════════════════════════════


# ── Core ──────────────────────────────────────────────────────────────────────

# [REQUIRED] PostgreSQL connection string.
# On Railway, use the INTERNAL host for the deployed API and worker.
# Use DATABASE_PUBLIC_URL only for running migrations from your own machine.
# NOTE: `${{Postgres.DATABASE_URL}}` is resolved at DEPLOY time, so after a
# password rotation you must redeploy api + worker or every DB route 500s.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/gyaanverse_dev

# [REQUIRED] Redis. Used by BullMQ (all queues) and by the rate limiter.
# Everything that makes evaluation self-healing lives in here — the repeatable
# schedules for the reconciler, the exam lifecycle tick and the daily digest.
REDIS_URL=redis://localhost:6379

# [REQUIRED] Which mode to run in. `production` turns on real email/SMS sending,
# locks CORS to APP_DOMAIN, sets secure cookies, and hides the operator surfaces
# unless you give them passwords (see the Operator Surfaces section).
# Anything that is not exactly "production" counts as development.
NODE_ENV=development

# [REQUIRED] Port the API listens on. Railway injects this itself — do not set it
# there. Local dev uses 8000.
PORT=8000

# [REQUIRED] The root domain the product runs on. Drives three things:
#   - which origins CORS accepts (`https://APP_DOMAIN` + any subdomain of it)
#   - the session cookie's Domain, so a login survives moving between subdomains
#   - the From address on outgoing email (noreply@APP_DOMAIN)
# Do NOT put a scheme or a port here. Just the domain.
APP_DOMAIN=gyaanverse.com


# ── Auth ──────────────────────────────────────────────────────────────────────

# [REQUIRED] Signing secret for sessions. Generate a fresh one per environment:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Changing it signs every user out. Never reuse the dev value in staging or prod.
BETTER_AUTH_SECRET=

# [REQUIRED] The API's own public base URL — where the browser reaches THIS
# service, not the frontend. Better Auth builds its callback URLs from it, and
# the API docs page uses it as the "Try it out" target.
#   local        http://app.lvh.me:8000
#   staging      https://api-staging.gyaanverse.com
#   production   https://api.gyaanverse.com
BETTER_AUTH_URL=http://app.lvh.me:8000

# [OPTIONAL] Base URL of the Next.js FRONTEND. Every link we email out (verify
# your email, reset password, teacher invite) points here.
# Default: production → https://APP_DOMAIN, otherwise → http://app.lvh.me:3000
# Set it explicitly in staging, or invite emails will send people to production.
FRONTEND_URL=


# ── File storage (Cloudinary) ─────────────────────────────────────────────────
# Student answer photos, question images, coaching logos. The AI engine reads the
# answer images straight from these URLs, so the account must serve them publicly.

# [REQUIRED] From the Cloudinary dashboard.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# [OPTIONAL] Top folder every upload goes under. Default: gyaanverse
# Give staging its own folder so test uploads never mix with real student work.
CLOUDINARY_UPLOAD_FOLDER=gyaanverse

# [OPTIONAL] Largest single upload we will sign, in bytes. Default: 10485760 (10 MB)
# A phone photo of an answer sheet is normally 2-5 MB.
STORAGE_MAX_UPLOAD_BYTES=10485760


# ── Email ─────────────────────────────────────────────────────────────────────

# [REQUIRED] Resend API key. Only actually used to SEND when NODE_ENV=production;
# in dev everything goes to Mailpit instead. Still required at boot in every
# environment, so put any placeholder here locally.
# The sending domain must be verified in Resend or every email silently bounces.
RESEND_API_KEY=placeholder_resend_api_key

# [DEV ONLY] Local mail catcher. Defaults: localhost / 1025.
# Nothing is sent to the real internet in dev — open http://127.0.0.1:8025 to read
# it. Leave these unset in staging and production; they are ignored there.
MAILPIT_HOST=127.0.0.1
MAILPIT_PORT=1025


# ── SMS / OTP (MSG91) ─────────────────────────────────────────────────────────

# [PROD ONLY] Leave EMPTY in dev and the OTP is printed to the console instead of
# being texted — which is what you want locally. In production all three are
# required and the API will not start without them.
MSG91_AUTH_KEY=
MSG91_TEMPLATE_ID=
MSG91_SENDER_ID=

# [OPTIONAL] Per-notification-type template override. The worker looks for
# MSG91_<TYPE>_TEMPLATE_ID first and falls back to MSG91_TEMPLATE_ID above.
# Example: MSG91_EXAM_PUBLISHED_TEMPLATE_ID=64f...


# ── Payments (Razorpay) ───────────────────────────────────────────────────────

# [REQUIRED] Keys from the Razorpay dashboard. Use TEST keys (rzp_test_...) in dev
# and staging; only production gets live keys.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# [REQUIRED] Secret for verifying subscription webhooks. This is NOT the API
# secret above — it is set separately when you create the webhook in Razorpay.
# If it is wrong, every webhook is rejected as a forgery and subscriptions never
# update.
RAZORPAY_WEBHOOK_SECRET=

# [OPTIONAL, but needed for paid plans to work] The Razorpay plan IDs that map to
# our three paid tiers. A subscription webhook whose plan ID matches none of
# these is treated as `free` — so leaving these blank in production silently
# downgrades every paying customer instead of erroring. Create the plans in the
# Razorpay dashboard and paste the IDs here.
RAZORPAY_PLAN_STARTER=
RAZORPAY_PLAN_GROWTH=
RAZORPAY_PLAN_PRO=


# ── AI evaluation engine ──────────────────────────────────────────────────────
# The Python/Flask service in AI_Engines/ that reads handwriting and grades it.
# It has its own environment file — see AI_Engines/engines/.env.

# [OPTIONAL] Base URL of the engine. Default: http://localhost:5000/evaluation_engine
# ⚠️ The URL MUST include the engine's blueprint prefix. exp_04 was renamed to
# evaluation_engine (its old exp_04_context_and_step_itr2 folder is now empty
# except leftover .pyc cache — no source left there). Without the prefix every
# call 404s and the whole pipeline reports the engine as unreachable.
EVAL_ENGINE_URL=http://localhost:5000/evaluation_engine

# [OPTIONAL] How long to wait for one engine call before giving up.
# Default: 120000 (2 minutes). Grading one handwritten answer genuinely takes
# tens of seconds, so do not lower this without measuring first.
EVAL_ENGINE_TIMEOUT_MS=120000

# [OPTIONAL] Fallback vector-DB collection for exams with no subject set.
# Default: empty (the engine uses its own default). Normally left blank —
# each exam uses `subject_<subjectId>` automatically.
EVAL_DEFAULT_COLLECTION=

# [OPTIONAL] Base URL of the blank-page detector — a separate, small engine at
# AI_Engines/engines/image_processing. Pixel-only (OpenCV), no OCR/LLM, answers
# in milliseconds whether an image has anything written on it. Not the same
# service/prefix as EVAL_ENGINE_URL. Default: http://localhost:5000/image_processing
BLANK_PAGE_ENGINE_URL=http://localhost:5000/image_processing

# [OPTIONAL] How long to wait for the blank-page detector before giving up and
# falling back to the normal OCR-retry path. Default: 10000 (10s) — this is a
# local pixel check, not an AI call, so it should never need anywhere near
# EVAL_ENGINE_TIMEOUT_MS.
BLANK_PAGE_ENGINE_TIMEOUT_MS=10000


# ── Evaluation throughput ─────────────────────────────────────────────────────
# ⚠️ These are the numbers that decide how fast a class of papers gets graded.
# They only affect the WORKER process, not the API.

# [OPTIONAL] How many papers one worker grades at the same time. Default: 5
# BullMQ's own default is 1, which would grade a 200-student exam strictly one
# paper after another — hours of wall-clock with nothing on screen explaining it.
# Raising this past what the engine can actually serve does not help: it just
# turns a capacity problem into a pile of timeouts. Add engine capacity first.
EVAL_WORKER_CONCURRENCY=5

# [OPTIONAL] Queue-wide speed limit: at most EVAL_RATE_MAX jobs may START per
# EVAL_RATE_DURATION_MS. Defaults: 30 per 60000ms.
# This is enforced in Redis, so it is a total across EVERY worker replica, not a
# per-process limit — that is what makes it still correct after you scale up.
# ⚠️ It counts JOB STARTS, not AI calls. One job is one student's paper, and each
# subjective question on it makes up to two AI calls. Real call rate is roughly
#   EVAL_RATE_MAX x questions x 2
# Set it against your OpenAI/Gemini quota using that, not the raw number.
EVAL_RATE_MAX=30
EVAL_RATE_DURATION_MS=60000

# [OPTIONAL] Circuit breaker — stops hammering an engine that is already down.
# Defaults: 5 failures / 30000ms.
# After EVAL_BREAKER_THRESHOLD unreachable-or-timeout results in a row, calls fail
# instantly for EVAL_BREAKER_OPEN_MS instead of each one waiting out the full
# 2-minute timeout. Jobs are still retried on their normal schedule — this only
# stops us paying 2 minutes to re-learn something we already know.
EVAL_BREAKER_THRESHOLD=5
EVAL_BREAKER_OPEN_MS=30000

# [OPTIONAL] Which queues this worker process consumes. Default: all
#   all          everything in one process — right for local dev and a single
#                worker service (what we run today)
#   evaluation   grading only. This is the half you scale: run N of them
#   general      email + SMS + bulk + the once-a-minute control ticks.
#                Effectively a singleton — never run more than one
# ⚠️ If you ever split them, you need BOTH deployed. Running only `evaluation`
# means no emails go out and no self-healing sweeps run at all.
WORKER_ROLE=all


# ── Operator surfaces (for Gyaanverse staff, not for coachings) ────────────────
#
# ONE RULE COVERS BOTH SURFACES BELOW:
#   dev / staging   mounted and open, unless you set a password
#   production      mounted ONLY if a password is set. No password = the URL
#                   does not exist (404), never "exists but unprotected"
#
# That is deliberate. The alternative failure — you forget to copy a variable to
# the new environment and the surface quietly goes public — is far worse than
# noticing a 404 the first time you go looking for it.

# ── Queue dashboard at /queues (Bull Board) ──
# Shows all six queues: evaluation, email, SMS, bulk, exam lifecycle, reconciler.
# This is a WRITE surface — it can retry, promote and delete jobs across every
# coaching, with no audit trail — so it must never be left open in production.
# [OPTIONAL] Default user: ops
BULL_BOARD_USER=ops
# [PROD: set this or the board is not mounted] Any long random string.
BULL_BOARD_PASSWORD=
# [OPTIONAL] Extra IP allowlist, comma-separated, checked BEFORE the password.
# A blocked address gets 404, so it learns nothing. Defence in depth only —
# behind Railway's proxy the client IP is one hop of a header the client sends,
# so never rely on this alone.
BULL_BOARD_IPS=

# ── API documentation at /docs and /openapi.json (Swagger) ──
# Read-only, but it is a complete machine-readable map of every route and its
# parameters, and it is meant for us — coachings integrate through the frontend.
# Same rule as above: open in dev/staging, off in production unless you set a
# password. (/internal/* and /queues are never in it either way.)
# [OPTIONAL] Default user: docs
API_DOCS_USER=docs
# [PROD: set this or /docs and /openapi.json return 404] Any long random string.
API_DOCS_PASSWORD=
# [OPTIONAL] Same allowlist behaviour as BULL_BOARD_IPS.
API_DOCS_IPS=


# ── Internal ops panel (the separate Vite app in ops/) ────────────────────────

# [OPTIONAL] Origin of the operator panel. Leave EMPTY while it lives at
# admin.<APP_DOMAIN> — the CORS subdomain rule already covers that.
# Set it the day the panel moves to its own domain; that is the whole backend
# change. ⚠️ If you forget, the panel breaks with a CORS error in the browser,
# which looks nothing like the config problem it actually is.
OPS_ORIGIN=

# [OPTIONAL] How long an operator may keep using one login against /internal/*
# before signing in again. Default: 43200000 (12 hours).
# Shorter than the normal session on purpose: these routes read across every
# coaching and write scores, so a forgotten laptop is not one coaching's problem.
OPS_SESSION_MAX_AGE_MS=43200000

# [OPTIONAL] Daily digest of answers waiting on a human reviewer.
# Defaults: 8am, Asia/Kolkata. Sent ONLY on days something is actually waiting —
# no "all clear" email, because a daily all-clear becomes a filter rule.
# It always goes to every super_admin account; OPS_DIGEST_EMAILS ADDS to that
# list, it never replaces it.
OPS_DIGEST_CRON=0 8 * * *
OPS_DIGEST_TZ=Asia/Kolkata
OPS_DIGEST_EMAILS=


# ── Local development helpers ─────────────────────────────────────────────────
# None of these do anything in production. Safe to leave unset everywhere.

# [DEV ONLY] Print every SQL query each request runs, as a box in the terminal —
# the fastest way to spot an N+1. On by default in dev, off in production and in
# tests. Set to 1 to force it on (e.g. to trace a failing test), 0 to force off.
# DB_QUERY_LOG=1

# [DEV ONLY] Set to `full` to print whole SQL statements and their bind values
# instead of the one-line summary.
# DB_QUERY_LOG_SQL=full

# [TEST ONLY] Separate database for `npm test`. Read from .env.test, not from
# here. The suite TRUNCATES every table before each test and refuses to run
# unless the URL contains the word "test".
# DATABASE_URL_TEST=postgresql://postgres:postgres@localhost:5432/gyaanverse_test

# [DEV ONLY] Answer-sheet image folder for `npm run seed:studio`.
# SEED_STUDIO_SHEETS_DIR=

# [DEV ONLY] Inputs for `npm run eval:fixture`, which pushes one paper through the
# real AI engine end to end. Defaults to a bundled image and the `dev` tenant.
# EVAL_FIXTURE_IMAGE=
# EVAL_FIXTURE_TENANT=dev
