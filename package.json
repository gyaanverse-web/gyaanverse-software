{
  "name": "gyaanverse-backend",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "dev": "tsx watch src/server.ts",
    "dev:worker": "tsx watch src/worker.ts",
    "build": "tsc -p tsconfig.build.json && tsc-alias -p tsconfig.build.json",
    "start": "node dist/server.js",
    "start:worker": "node dist/worker.js",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:studio": "drizzle-kit studio",
    "db:seed": "tsx scripts/seed.ts",
    "db:seed:questions": "tsx scripts/seed-questions.ts",
    "db:seed:platform": "tsx scripts/seed-platform-questions.ts",
    "seed:studio": "tsx scripts/seed-studio.ts",
    "db:reset": "tsx scripts/reset-db.ts",
    "ops:promote": "tsx scripts/ops-promote.ts",
    "eval:fixture": "tsx scripts/eval-fixture.ts",
    "eval:inspect": "tsx scripts/eval-inspect.ts",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@bull-board/api": "^7.1.5",
    "@bull-board/fastify": "^7.1.5",
    "@fastify/cookie": "^11.0.2",
    "@fastify/cors": "^11.2.0",
    "@fastify/helmet": "^13.0.2",
    "@fastify/rate-limit": "^10.3.0",
    "@fastify/sensible": "^6.0.1",
    "@fastify/swagger": "^9.7.0",
    "@fastify/swagger-ui": "^5.2.6",
    "better-auth": "~1.6.0",
    "bullmq": "^5.30.7",
    "cloudinary": "^2.10.0",
    "dotenv": "^16.4.5",
    "drizzle-orm": "^0.45.2",
    "drizzle-zod": "^0.5.1",
    "fastify": "^5.8.5",
    "ioredis": "^5.4.2",
    "nodemailer": "^8.0.7",
    "pg": "^8.13.1",
    "pino-pretty": "^13.0.0",
    "razorpay": "^2.9.6",
    "resend": "^4.0.2",
    "zod": "^3.25.1"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/nodemailer": "^8.0.0",
    "@types/pg": "^8.11.10",
    "drizzle-kit": "^0.31.10",
    "pptxgenjs": "^4.0.1",
    "tsc-alias": "^1.9.1",
    "tsx": "^4.19.0",
    "typescript": "^5.8.0",
    "vitest": "^2.1.8"
  }
}